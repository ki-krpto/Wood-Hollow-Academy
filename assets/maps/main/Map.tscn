[node name="Scholar Orin (SB)" type="StaticBody2D" parent="Entities" unique_id=2123456701]
position = Vector2(387, 1919)
script = ExtResource("npc_id")
dialogue_text = "These Sanctuary Altars were raised by the Legend long ago. |Their magic is the only thing keeping the acid dragons at bay. |Every altar we know of still hums with that same faint light. |Some say the Legend's own soul is bound into the stones."
display_name = "Scholar Orin"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Entities/Scholar Orin (SB)" unique_id=2123456702]
position = Vector2(0, 1)
shape = SubResource("RectangleShape2D_vivi_col")

[node name="Sprite2D" type="Sprite2D" parent="Entities/Scholar Orin (SB)" unique_id=2123456703]
position = Vector2(-2, -7.000004)
scale = Vector2(0.7, 0.7)
texture = ExtResource("villager_tex")

[node name="Apprentice Lena (SB)" type="StaticBody2D" parent="Entities" unique_id=2123456704]
position = Vector2(611, 1887)
script = ExtResource("npc_id")
dialogue_text = "I'm learning to read the old scrolls. |Woodhollow Academy teaches history, swords, and a little magic. |Mostly we learn how to survive down here. |The surface used to be so much more than ash and ruin."
display_name = "Apprentice Lena"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Entities/Apprentice Lena (SB)" unique_id=2123456705]
position = Vector2(0, 1)
shape = SubResource("RectangleShape2D_vivi_col")

[node name="Sprite2D" type="Sprite2D" parent="Entities/Apprentice Lena (SB)" unique_id=2123456706]
position = Vector2(0, -6.000002)
scale = Vector2(0.7, 0.7)
texture = ExtResource("villager_tex")
flip_h = true

[node name="Survivor Bram (SB)" type="StaticBody2D" parent="Entities" unique_id=2123456707]
position = Vector2(420, 2014)
script = ExtResource("npc_id")
dialogue_text = "I fled from the WoodHollow Sovereignty when the dragons came. |My whole village turned to glass and acid in a single night. |We built everything we have around these altars. |The barrier kept the worst of it out."
display_name = "Survivor Bram"

[node name="CollisionShape2D" type="CollisionShape2D" parent="Entities/Survivor Bram (SB)" unique_id=2123456708]
shape = SubResource("RectangleShape2D_vivi_col")

