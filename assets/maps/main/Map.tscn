texture = ExtResource("villager_tex")

[node name="Sentinel Kael (SB)" type="StaticBody2D" parent="Entities" unique_id=2123456710]
position = Vector2(578, 2048)
script = ExtResource("npc_id")
dialogue_text = "Don't touch the altar's core. That's the first law. |It's said to unleash wild magic no one can control. |I've guarded this sanctuary for twenty years. |Only the Legend ever dared to speak to it directly."
display_name = "Sentinel Kael"

