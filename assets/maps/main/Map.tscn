[node name="Novice Rian (SB)" type="StaticBody2D" parent="Entities" unique_id=2123456713]
position = Vector2(674, 1982)
script = ExtResource("npc_id")
dialogue_text = "The altar glows a little brighter when people are near. |I bet it likes us! |One day I'll be a great scholar and understand it. |But first, the master says I have to learn to hold a sword."
